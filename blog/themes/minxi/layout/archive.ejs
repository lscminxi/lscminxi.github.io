<div class="page-heading"><div class="eyebrow">THE LEARNING LOG</div><h1><%= is_tag() ? '# ' + page.tag : is_category() ? page.category : '文章归档' %><span class="accent-dot">.</span></h1><p><%= is_tag() || is_category() ? '沿着一个主题，一点一点深入。' : '每一篇笔记，都是向前走过的一小步。' %></p><a class="back-link" href="<%- url_for('/') %>">← 回到首页</a></div>
<div class="content-grid archive-grid"><section><div class="section-heading"><h2>全部记录 <span class="count-badge"><%= page.total ? page.posts.length : site.posts.length %></span></h2><span class="mono muted">LATEST FIRST</span></div><% let year = ''; page.posts.each(function(post) { const postYear = date(post.date, 'YYYY'); if (postYear !== year) { year = postYear; %><h2 class="archive-year"><%= year %><span> / JOURNAL</span></h2><% } %><%- partial('_partial/card', { post }) %><% }); %><% if (page.total > 1) { %><nav class="pagination" aria-label="文章分页"><%- paginator({ prev_text: '← 上一页', next_text: '下一页 →' }) %></nav><% } %></section><%- partial('_partial/sidebar') %></div>
