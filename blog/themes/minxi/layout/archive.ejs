<div class="page-heading"><div class="eyebrow">THE LEARNING LOG</div><h1><%= is_tag() ? '# ' + page.tag : is_category() ? page.category : '文章归档' %><span class="accent-dot">.</span></h1><p><%= is_tag() || is_category() ? '沿着一个主题，一点一点深入。' : '一个小小的愿望：没有人嘲讽我的小糖文' %></p><a class="back-link" href="<%- url_for('/') %>">← 回到首页</a></div>
<% const isMainArchive = !page.year && (page.current || 1) === 1 && !is_tag() && !is_category(); -%>
<% const pinnedPosts = isMainArchive ? site.posts.toArray().filter(function(post) { return post.sticky; }).sort(function(a, b) { return b.date - a.date; }) : []; -%>
<% const listPosts = page.posts.toArray().filter(function(post) { return !(isMainArchive && post.sticky); }); -%>
<div class="content-grid archive-grid" id="latest"><section><div class="section-heading"><h2><span class="section-icon">≡</span> 最新笔记 <span class="count-badge"><%= (page.total ? page.posts.length : site.posts.length).toString().padStart(2, '0') %></span></h2><span class="mono muted">LATEST FIRST</span></div><div class="category-filters" aria-label="筛选文章"><button class="filter active" data-filter="all" aria-pressed="true">全部</button><% site.categories.each(function(category) { %><button class="filter" data-filter="<%= category.name %>" aria-pressed="false"><%= category.name %></button><% }) %></div>
<% if (pinnedPosts.length) { %><div class="pinned-block"><h3 class="pinned-title"><span>◆</span> 置顶 <span class="subtle-label">PINNED</span></h3><% pinnedPosts.forEach(function(post) { %><%- partial('_partial/card', { post }) %><% }) %></div><% } %>
<% let year = ''; listPosts.forEach(function(post) { const postYear = date(post.date, 'YYYY'); if (postYear !== year) { year = postYear; %><h2 class="archive-year"><%= year %><span> / JOURNAL</span></h2><% } %><%- partial('_partial/card', { post }) %><% }); %>
<p class="filter-empty" hidden>当前页还没有这个分类的文章。<a href="<%- url_for('/archives/') %>">查看全部归档 →</a></p><% if (page.total > 1) { %><nav class="pagination" aria-label="文章分页"><%- paginator({ prev_text: '← 上一页', next_text: '下一页 →' }) %></nav><% } %></section><%- partial('_partial/sidebar') %></div>
