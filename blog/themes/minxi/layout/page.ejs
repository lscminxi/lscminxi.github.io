<div class="page-heading"><div class="eyebrow"><%= page.eyebrow || 'A LITTLE MORE ABOUT ME' %></div><h1><%= page.title %><span class="accent-dot">.</span></h1><p><%= page.description || config.subtitle %></p></div>
<% if (page.kind === 'tags') { %><section class="tags-page"><% site.tags.sort('length', -1).each(function(tag, index) { %><a class="tag-tile" href="<%- url_for(tag.path) %>"><span class="tag-tile-index"><%= String(index + 1).padStart(2, '0') %> / TOPIC</span><h2><span>#</span> <%= tag.name %></h2><div><%= tag.length %> 篇笔记 <span>↗</span></div></a><% }); %></section><% } else { %><div class="about-layout"><article class="article-content about-content"><%- page.content %></article><%- partial('_partial/sidebar') %></div><% } %>
