<div class="post-layout"><article class="full-post"><a class="back-link" href="<%- url_for('/archives/') %>">← 全部笔记</a><header class="article-heading"><div class="post-card-meta"><% page.categories.each(function(category) { %><a class="category-label" href="<%- url_for(category.path) %>"><span></span><%= category.name %></a><% }) %><% if (page.sample) { %><span class="sample-label">示例文章</span><% } %></div><h1><%= page.title %></h1><p class="article-description"><%= page.description || '' %></p><div class="article-meta"><span><%= config.author %></span><span>/</span><time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY.MM.DD') %></time><span>/</span><span><%= read_minutes(page) %> 分钟阅读</span></div></header><% if (page.sample) { %><div class="sample-notice">这是一篇建站示例笔记，可作为写作参考，也可以直接修改或删除。</div><% } %><div class="article-content"><%- page.content %></div><footer class="article-bottom"><div class="post-tags"><% page.tags.each(function(tag) { %><a href="<%- url_for(tag.path) %>"># <%= tag.name %></a><% }) %></div></footer><% const commentsCfg = (theme.comments || {}); const giscusCfg = commentsCfg.giscus || {}; const useGiscus = commentsCfg.provider === 'giscus' && giscusCfg.repo && giscusCfg.repo_id && giscusCfg.category_id; %><section class="comments" id="comments" data-comments data-comments-provider="<%= useGiscus ? 'giscus' : 'local' %>" data-post-key="/<%= page.path.replace(/index\.html$/, '') %>" data-giscus-repo="<%= giscusCfg.repo || '' %>" data-giscus-repo-id="<%= giscusCfg.repo_id || '' %>" data-giscus-category="<%= giscusCfg.category || 'Announcements' %>" data-giscus-category-id="<%= giscusCfg.category_id || '' %>" aria-label="评论区"><div class="comments-head"><h2>评论 <span class="comments-count" data-comment-count>0</span></h2><button class="like-button" type="button" data-like-button aria-pressed="false"><span aria-hidden="true">♡</span> <span data-like-label>点赞</span> <span data-like-count>0</span></button></div><div data-giscus-target></div><div data-local-comments><p class="comments-hint" data-comment-user-hint>登录后才能评论或点赞</p><form class="comment-form" data-comment-form><label class="comment-label" for="comment-input-<%= page.path.replace(/[^a-zA-Z0-9]+/g, '-') %>">写下你的评论</label><textarea id="comment-input-<%= page.path.replace(/[^a-zA-Z0-9]+/g, '-') %>" data-comment-input rows="3" maxlength="500" placeholder="登录后发表评论，支持纯文本（最多 500 字）"></textarea><p class="auth-error" data-comment-error role="alert" hidden></p><div class="comment-form-actions"><span class="comments-mode-note"><% if (useGiscus) { %>评论由 GitHub Discussions 提供<% } else { %>当前为本地模式：评论只保存在你自己的浏览器里；站长启用 Giscus 后可全站共享<% } %></span><button class="auth-submit comment-submit" type="submit">发表评论</button></div></form><div class="comment-list" data-comment-list></div></div></section><nav class="post-navigation" aria-label="相邻文章"><% if (page.prev) { %><a href="<%- url_for(page.prev.path) %>"><small>← 更新一篇</small><strong><%= page.prev.title %></strong></a><% } %><% if (page.next) { %><a href="<%- url_for(page.next.path) %>"><small>更早一篇 →</small><strong><%= page.next.title %></strong></a><% } %></nav></article><aside class="toc-sidebar"><div class="toc-sticky"><h2><span>#</span> 本文目录</h2><%- toc(page.content, { list_number: false }) %><a class="toc-back" href="#main">↑ 回到顶部</a></div></aside></div>
