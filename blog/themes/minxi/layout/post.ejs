<div class="post-layout"><article class="full-post"><a class="back-link" href="<%- url_for('/archives/') %>">← 全部笔记</a><header class="article-heading"><div class="post-card-meta"><% page.categories.each(function(category) { %><a class="category-label" href="<%- url_for(category.path) %>"><span></span><%= category.name %></a><% }) %><% if (page.sample) { %><span class="sample-label">示例文章</span><% } %></div><h1><%= page.title %></h1><p class="article-description"><%= page.description || '' %></p><div class="article-meta"><span><%= config.author %></span><span>/</span><time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY.MM.DD') %></time><span>/</span><span><%= read_minutes(page) %> 分钟阅读</span></div></header><% if (page.sample) { %><div class="sample-notice">这是一篇建站示例笔记，可作为写作参考，也可以直接修改或删除。</div><% } %><div class="article-content"><%- page.content %></div><footer class="article-bottom"><div class="post-tags"><% page.tags.each(function(tag) { %><a href="<%- url_for(tag.path) %>"># <%= tag.name %></a><% }) %></div></footer><nav class="post-navigation" aria-label="相邻文章"><% if (page.prev) { %><a href="<%- url_for(page.prev.path) %>"><small>← 更新一篇</small><strong><%= page.prev.title %></strong></a><% } %><% if (page.next) { %><a href="<%- url_for(page.next.path) %>"><small>更早一篇 →</small><strong><%= page.next.title %></strong></a><% } %></nav></article><aside class="toc-sidebar"><div class="toc-sticky"><h2><span>#</span> 本文目录</h2><%- toc(page.content, { list_number: false }) %><a class="toc-back" href="#main">↑ 回到顶部</a></div></aside></div>
