<!DOCTYPE html>
<% const appearance = site_appearance(); -%>
<html lang="zh-CN" data-theme-default="<%= appearance.theme %>"<% if (appearance.hasWallpaper) { %> data-wallpaper="on" data-wallpaper-src="<%= appearance.wallpaper %>" data-wallpaper-dim="<%= appearance.wallpaperDim %>" data-wallpaper-blurpx="<%= appearance.wallpaperBlur %>"<% if (appearance.hasWallpaperBlur) { %> data-wallpaper-blur="on"<% } %><% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="no-referrer">
  <% const pageTitle = is_home() ? config.title : (page.title || (is_archive() ? '文章归档' : (page.tag || page.category || '文章'))) + ' · ' + config.title; -%>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= page.description || config.description %>">
  <meta name="theme-color" content="#0b0e14"><!-- 主题脚本会按当前主题更新它 -->
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= page.description || config.description %>">
  <meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>">
  <meta property="og:url" content="<%= config.url.replace(/\/$/, '') + url_for(page.path || '') %>">
  <link rel="canonical" href="<%= config.url.replace(/\/$/, '') + url_for(page.path || '') %>">
  <%# 访客端主题与背景选择：两个同步脚本，在样式表之前先定下 data-theme / 上次选的背景，
      因此不会先闪一下深色或默认壁纸（见 client/theme.js、client/wallpaper.js）。 -%>
  <script src="<%- url_for('/js/theme.js') %>?v=theme-1"></script>
  <script src="<%- url_for('/js/wallpaper.js') %>?v=wallpaper-2"></script>
  <link rel="icon"<% if (appearance.faviconType) { %> type="<%= appearance.faviconType %>"<% } %> href="<%= url_for(appearance.favicon) %>">
  <% if (appearance.faviconType === 'image/png') { %><link rel="apple-touch-icon" href="<%= url_for(appearance.favicon) %>">
  <% } %><link rel="stylesheet" href="<%- url_for('/css/main.css') %>?v=graph-sync-2">
  <link rel="stylesheet" href="<%- url_for('/vendor/katex/katex.min.css') %>">
  <% if (appearance.hasWallpaper) { %><style>
    :root {
      --wallpaper-image: <%- appearance.wallpaperImage %>;
      --wallpaper-veil: <%= appearance.wallpaperVeil %>;
      --wallpaper-blur: <%= appearance.wallpaperBlur %>px;
    }
  </style>
  <% } %><script src="<%- url_for('/js/main.js') %>?v=latex-search-1" defer></script>
  <script src="<%- url_for('/js/auth.js') %>?v=auth-1" defer></script>
  <script src="<%- url_for('/js/plot.js') %>?v=graph-sync-2" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">跳到正文</a>
  <%- partial('_partial/header') %>
  <main id="main" class="site-main"><%- body %></main>
  <%- partial('_partial/footer') %>
  <dialog id="search-dialog" class="search-dialog" aria-labelledby="search-title" data-index="<%- url_for('/search.json') %>">
    <div class="search-heading"><h2 id="search-title">搜索笔记</h2><button class="icon-button" id="close-search" aria-label="关闭搜索">×</button></div>
    <div class="search-input-wrap"><span aria-hidden="true">⌕</span><input id="search-input" type="search" placeholder="搜索文章、算法、标签，或 LaTeX 如 \sum、\frac{n}{2}…" autocomplete="off" aria-label="搜索文章、算法、标签或 LaTeX 公式"></div>
    <div id="search-results" aria-live="polite"><p class="search-hint">输入关键词以搜索</p></div>
    <div class="search-footer"><span>本地全文搜索 · 不追踪，不上传</span><kbd>ESC 关闭</kbd></div>
  </dialog>
  <button id="back-top" class="back-top" aria-label="返回顶部" hidden>↑</button>
  <%# 背景选择：所有人都能换，但只改自己浏览器里的记录，不改站点文件（wallpapers 由 admin 维护）。 -%>
  <dialog id="wallpaper-dialog" class="wallpaper-dialog" aria-labelledby="wallpaper-title" data-appearance="<%- url_for('/appearance.json') %>">
    <div class="wallpaper-heading"><h2 id="wallpaper-title">选择背景</h2><button class="icon-button" id="close-wallpaper" type="button" aria-label="关闭背景选择">×</button></div>
    <p class="wallpaper-lead">下面这些图片由站长管理。你的选择只保存在自己的浏览器里（localStorage），不会影响其他访客，也不会改动站点文件。</p>
    <p class="wallpaper-current" id="wallpaper-current"></p>
    <div class="wallpaper-grid" id="wallpaper-grid" role="group" aria-label="可选背景"></div>
    <section class="wallpaper-saved" aria-labelledby="wallpaper-saved-title">
      <div class="wallpaper-saved-head">
        <h3 id="wallpaper-saved-title">我保存的壁纸 <span id="wallpaper-saved-count"></span></h3>
        <button class="wallpaper-save-current" id="wallpaper-save-current" type="button">登录后保存</button>
      </div>
      <p class="wallpaper-saved-note" id="wallpaper-saved-note">登录后可以把当前壁纸保存到你的 GitHub 账号；下次用同一账号登录时会优先使用你自己的壁纸。保存内容只在这台设备的浏览器里，不会上传。</p>
      <div class="wallpaper-grid wallpaper-saved-grid" id="wallpaper-saved-grid" role="group" aria-label="我保存的壁纸"></div>
      <p class="wallpaper-saved-empty" id="wallpaper-saved-empty">还没有保存的壁纸。选好一张后点「保存当前壁纸」即可。</p>
    </section>
    <p class="wallpaper-status" id="wallpaper-status" role="status" hidden></p>
    <form class="wallpaper-custom" id="wallpaper-url-form">
      <label for="wallpaper-url">也可以填自己的图片外链</label>
      <div class="wallpaper-custom-row">
        <input id="wallpaper-url" type="text" spellcheck="false" autocomplete="off" placeholder="https://… 或 /images/壁纸.png" aria-label="自定义背景图片地址">
        <button type="submit">使用此链接</button>
      </div>
    </form>
    <div class="wallpaper-tune">
      <label for="wallpaper-dim"><span>压暗</span><input id="wallpaper-dim" type="range" min="0" max="95" step="1"><output id="wallpaper-dim-value" for="wallpaper-dim"></output></label>
      <label for="wallpaper-blur"><span>模糊</span><input id="wallpaper-blur" type="range" min="0" max="20" step="1"><output id="wallpaper-blur-value" for="wallpaper-blur"></output></label>
    </div>
    <div class="wallpaper-actions">
      <button class="wallpaper-plain" id="wallpaper-reset" type="button">恢复站点默认</button>
      <button class="wallpaper-primary" id="wallpaper-done" type="button">完成</button>
    </div>
  </dialog>
  <%# 访客登录：唯一方式是 GitHub OAuth（经 oauth-worker 换令牌确认身份）；
      登录后才能评论/点赞；后台仍然只有站长能进，访客登录不授予任何后台权限。 -%>
  <% const authCfg = (theme.auth || {}); const oauthCfg = authCfg.oauth || {}; const oauthReady = authCfg.provider === 'oauth' && oauthCfg.client_id && oauthCfg.worker_url; %><dialog id="auth-dialog" class="auth-dialog" aria-labelledby="auth-title" data-auth-provider="<%= oauthReady ? 'oauth' : 'unconfigured' %>" data-oauth-client-id="<%= oauthCfg.client_id || '' %>" data-oauth-worker-url="<%= oauthCfg.worker_url || '' %>" data-oauth-scope="<%= oauthCfg.scope || 'read:user' %>">
    <div class="auth-heading"><h2 id="auth-title">登录</h2><button class="icon-button" id="auth-close" type="button" aria-label="关闭登录">×</button></div>
    <div id="auth-login-panel">
      <p class="auth-lead">使用 <strong>GitHub 官方授权</strong> 登录后，可以给文章评论和点赞。本站不会接触你的 GitHub 密码。</p>
      <div id="auth-oauth-panel" hidden>
        <button class="auth-submit auth-oauth-button" id="auth-oauth-button" type="button">使用 GitHub 登录</button>
        <p class="auth-note">会跳转到 GitHub 官方授权页确认身份（只申请读取公开资料），授权后自动跳回；令牌用完即弃、不保存。</p>
      </div>
      <p class="auth-unconfigured" id="auth-unconfigured" hidden>GitHub 登录尚未配置完成，暂时无法登录，请稍后再试。</p>
      <p class="auth-error" id="auth-error" role="alert" hidden></p>
      <p class="auth-note">后台只有站长本人经 GitHub 授权才能进入，普通登录不授予后台权限。</p>
    </div>
    <div id="auth-account-panel" hidden>
      <p class="auth-lead" id="auth-account-info"></p>
      <div class="auth-account-actions">
        <button class="auth-submit" id="auth-admin" type="button">进入后台</button>
        <button class="auth-secondary" id="auth-logout" type="button">退出登录</button>
        <button class="auth-secondary" id="auth-account-close" type="button">关闭</button>
      </div>
    </div>
  </dialog>
  <dialog id="auth-required-dialog" class="auth-dialog" aria-labelledby="auth-required-title">
    <div class="auth-heading"><h2 id="auth-required-title">请先登录</h2></div>
    <p class="auth-lead" id="auth-required-text">你还没有登录，登录后才能使用此功能。</p>
    <div class="auth-account-actions">
      <button class="auth-submit" id="auth-required-go" type="button">去登录</button>
      <button class="auth-secondary" id="auth-required-cancel" type="button">取消</button>
    </div>
  </dialog>
  <dialog id="auth-noaccess-dialog" class="auth-dialog" aria-labelledby="auth-noaccess-title">
    <div class="auth-heading"><h2 id="auth-noaccess-title">你无权限进入</h2></div>
    <p class="auth-lead" id="auth-noaccess-text">你无权限进入后台，只有站长才能进入。</p>
    <div class="auth-account-actions">
      <button class="auth-submit" id="auth-noaccess-close" type="button">知道了</button>
    </div>
  </dialog>
</body>
</html>
