<div class="header-hover-zone" aria-hidden="true"></div>
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="<%- url_for('/') %>" aria-label="Minxi 的 blog 首页"><span class="brand-mark"><img class="brand-mark-image" src="https://cdn.luogu.com.cn/upload/usericon/1549479.png" alt="" width="39" height="39" decoding="async" referrerpolicy="no-referrer"></span><span>Minxi<span class="brand-suffix"> 的 blog</span></span></a>
    <nav class="desktop-nav" aria-label="主导航">
      <a class="<%= is_home() ? 'active' : '' %>" href="<%- url_for('/') %>" <%- is_home() ? 'aria-current="page"' : '' %>>首页</a>
      <a class="<%= is_archive() || is_post() ? 'active' : '' %>" href="<%- url_for('/archives/') %>">归档</a>
      <a class="<%= is_tag() || is_category() || page.path === 'tags/index.html' ? 'active' : '' %>" href="<%- url_for('/tags/') %>">标签</a>
      <a class="<%= page.path === 'about/index.html' ? 'active' : '' %>" href="<%- url_for('/about/') %>">关于</a>
    </nav>
    <div class="header-actions"><button class="search-trigger" aria-label="搜索文章"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><span>搜索</span><kbd>/</kbd></button></div>
  </div>
</header>
