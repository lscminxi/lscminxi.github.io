<article class="post-card" data-category="<%= post.categories.length ? post.categories.first().name : '未分类' %>">
  <div class="post-card-meta"><span class="category-label <%= post.accent || '' %>"><span></span><%= post.categories.length ? post.categories.first().name : '未分类' %></span><% if (post.sticky) { %><span class="pin-label">置顶</span><% } %><% if (post.sample) { %><span class="sample-label">示例文章</span><% } %><time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY.MM.DD') %></time></div>
  <h3><a href="<%- url_for(post.path) %>"><%= post.title %><span class="card-arrow" aria-hidden="true">↗</span></a></h3>
  <p class="post-description"><%= post.description || truncate(strip_html(post.excerpt || post.content), { length: 110 }) %></p>
  <div class="post-card-bottom"><div class="post-tags"><% post.tags.limit(3).each(function(tag) { %><a href="<%- url_for(tag.path) %>"><span>#</span> <%= tag.name %></a><% }) %></div><span class="read-time"><svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="10" cy="10" r="7.5"/><path d="M10 5v5l3 2"/></svg><%= read_minutes(post) %> 分钟阅读</span></div>
</article>
